<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  id="approval-definitions"
                  targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:message id="approval_requested" name="approval_requested" />
  <bpmn:process id="approval_process" isExecutable="true" camunda:historyTimeToLive="P1D">
    <bpmn:startEvent id="start" />
    <bpmn:startEvent id="start_by_message">
      <bpmn:messageEventDefinition messageRef="approval_requested" />
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="to_approve" sourceRef="start" targetRef="approve" />
    <bpmn:sequenceFlow id="message_to_approve" sourceRef="start_by_message" targetRef="approve" />
    <bpmn:userTask id="approve" name="Approve" />
    <bpmn:sequenceFlow id="to_end" sourceRef="approve" targetRef="end" />
    <bpmn:endEvent id="end" />
  </bpmn:process>
</bpmn:definitions>
